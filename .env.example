# =====================================================
# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
# =====================================================

# Entorno: development | production | test
NODE_ENV=development
PORT=3001

# ---- Base de datos (PostgreSQL / pgAdmin) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vivero
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena
# true = imprime cada consulta SQL en consola (solo para depurar)
DB_LOGGING=false

# ---- Autenticacion JWT ----
# Usa una cadena larga y aleatoria (minimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# Formato de jsonwebtoken: 15m, 2h, 1d, 7d...
JWT_EXPIRES_IN=1d

# ---- Hash de contrasenas (bcrypt) ----
BCRYPT_ROUNDS=10

# ---- Subida de archivos (local) ----
# Carpeta publica donde se guardan: public/uploads/<entidad>/<id>/<archivo>
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE_MB=5

# ---- Seeder (npm run seed) ----
# Contrasena de los usuarios de prueba admin_test / trabajador_test / cliente_test
SEED_PASSWORD=Vivero123*

# ---- CORS ----
# Origenes permitidos separados por coma. "*" permite cualquiera (solo desarrollo).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
